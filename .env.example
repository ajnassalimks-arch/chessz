# Supabase Free Tier Keys (Optional for Cloud Sync)
# Get these from your Supabase Dashboard: Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# --- Optional: cross-device login via Lichess (server-only, never exposed to the browser) ---
# When both are set, connecting Lichess silently creates/links a Supabase
# account keyed to that Lichess identity. Reconnect Lichess on any device and
# the same saved blunder library loads -- no email or password the player ever
# sees. Without these, Supabase (if configured above) still saves each browser
# to its own anonymous session, and without Supabase at all, saves stay in
# that browser's localStorage. Either way the app works; this just makes the
# saved library follow the player instead of the device.
#
# Project Settings > API > service_role (the SECRET key, not anon -- never
# commit it, never send it to the client)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
# Any long random string, generated once. Rotating it signs out every
# Lichess-linked session, since it changes the derived credential.
LICHESS_AUTH_SECRET=generate-a-long-random-secret-here
